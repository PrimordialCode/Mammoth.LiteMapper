{
  "version": 1,
  "root_dir": ".",
  "exclude": [
    "target/**",
    ".git/**",
    ".tokensave/**",
    "**/node_modules/**",
    "vendor/**",
    "**/*.min.*",
    "bin/**",
    "build/**",
    "out/**",
    ".gradle/**",
    "**/bin/**",
    "**/obj/**"
  ],
  "include": [],
  "max_file_size": 1048576,
  "extract_docstrings": true,
  "track_call_sites": true,
  "git_ignore": false,
  "default_path_include": [],
  "default_path_exclude": [],
  "source_path_overrides": [],
  "docs_dir": "tokensave-docs",
  "last_indexed_version": "7.11.1",
  "auto_track": true,
  "strict_tree": false,
  "max_auto_sync_files": 2000,
  "report_savings": true,
  "artifact_extensions": [
    "feature",
    "json",
    "yaml",
    "yml",
    "sql",
    "toml",
    "proto",
    "graphql",
    "md"
  ],
  "suppress_scope_warning": false
}