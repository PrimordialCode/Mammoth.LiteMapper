<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RoslynTestVersion Condition="'$(RoslynTestVersion)' == ''">4.8.0</RoslynTestVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Snapshots\**\*.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
    <!-- Forces the compatible Workspaces dependency instead of NuGet choosing 3.8.0 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynTestVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Mammoth.LiteMapper.Abstractions\Mammoth.LiteMapper.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Mammoth.LiteMapper.Generator\Mammoth.LiteMapper.Generator.csproj" />
    <ProjectReference Include="..\Mammoth.LiteMapper.AllocationTestHost\Mammoth.LiteMapper.AllocationTestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RoslynTestVersion</_Parameter1>
      <_Parameter2>$(RoslynTestVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="CopyAllocationTestHost" AfterTargets="Build">
    <MSBuild Projects="..\Mammoth.LiteMapper.AllocationTestHost\Mammoth.LiteMapper.AllocationTestHost.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="_AllocationTestHostTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_AllocationTestHostDirectory>@(_AllocationTestHostTargetPath->'%(RootDir)%(Directory)')</_AllocationTestHostDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_AllocationTestHostFiles Include="$(_AllocationTestHostDirectory)*.dll" />
      <_AllocationTestHostFiles Include="@(_AllocationTestHostTargetPath->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <_AllocationTestHostFiles Include="@(_AllocationTestHostTargetPath->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AllocationTestHostFiles)"
          DestinationFolder="$(TargetDir)AllocationTestHost"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
